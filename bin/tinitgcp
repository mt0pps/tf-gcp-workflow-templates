#!/usr/bin/env bash

if [[ $1 = -d ]]; then
    set -x
    shift
fi

invocation_dir=$PWD
git_project_dir="$(git rev-parse --show-toplevel 2>/dev/null || true)"

if [[ -z $git_project_dir ]]; then
    search_root=/
else
    search_root=$git_project_dir
fi

folder_name="$(basename "$invocation_dir")"

project_config=
config_search_dir=$invocation_dir
while :; do
    if [[ -r $config_search_dir/.tinitgcp ]]; then
        project_config="$config_search_dir/.tinitgcp"
        break
    fi

    if [[ $config_search_dir = $search_root ]]; then
        break
    fi

    config_search_dir=$(dirname "$config_search_dir")
done

if [[ -n $project_config ]]; then
    config_dir=$(dirname "$project_config")
else
    config_dir=$invocation_dir
fi

if [[ $# -eq 1 ]]; then
    if [[ ! -r $project_config ]]; then
        echo "Project config '.tinitgcp' not found between '$invocation_dir' and '$search_root'"
        exit 2
    else
        env=$1
        declare -A state_location
        # shellcheck source=/dev/null
        . $project_config
        state_path=${state_location[$env]}
    fi
elif [[ $# -eq 2 ]]; then
    env=$2
    if [[ -n $project_config ]]; then
        echo "Error: this project has a .tinitgcp file but common state argument '${env}' given"
        exit 3
    fi
    state_path="$1"
    shift
else
    echo "Usage: tinitgcp [-d] [BUCKET/PREFIX] ENVIRONMENT"
    exit 4
fi

env_vars_file="${config_dir}/environments/${env}.tfvars"

if [[ ! -f "$env_vars_file" ]]; then
    case "$env" in
        sandbox)
            env_vars_file="${config_dir}/environments/sand.tfvars"
            ;;
    esac
fi

if [[ ! -f "$env_vars_file" ]]; then
    echo "Warning: environment vars file '${env_vars_file}' not found" >&2
fi

bucket=${state_path%%/*}
base_prefix=${state_path#*/}

if [[ $PWD != $invocation_dir ]]; then
    prev_pwd=${PWD}
    cd "$invocation_dir"
fi

set -x
terraform init -reconfigure -backend-config="bucket=$bucket" -backend-config="prefix=$base_prefix"
set +x

if [[ -n $prev_pwd ]]; then
    cd $prev_pwd
    unset prev_pwd
fi
